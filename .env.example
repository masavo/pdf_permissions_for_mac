# Copy this file to .env and edit values before enabling the Folder Action.

# Process only PDF files whose basename starts with this prefix.
# Empty means all PDFs.
TARGET_PREFIX=""

# Required. This password controls permission changes in PDF readers.
OWNER_PASSWORD=""

# Optional. Empty means users can open the PDF without a password.
USER_PASSWORD=""

# Matches the requested access settings:
# - allow printing
# - allow text/graphics copy
# - disallow page insertion/deletion/rotation
# - allow annotations/signatures
# - disallow existing form field input
PERMISSION_POLICY="print_copy_annotate"

# Optional custom qpdf permission flags when PERMISSION_POLICY="custom".
# Example:
# QPDF_PERMISSION_ARGS="--print=full --extract=y --assemble=n --annotate=y --form=n --modify-other=n --accessibility=y"
# QPDF_PERMISSION_ARGS=""

# Empty LOG_FILE uses secure_pdf.log next to secure_pdf.sh.
# LOG_FILE="/absolute/path/to/secure_pdf.log"
# QPDF_BIN="/opt/homebrew/bin/qpdf"
STABILITY_CHECKS="3"
STABILITY_INTERVAL_SECONDS="1"
STABILITY_TIMEOUT_SECONDS="120"
